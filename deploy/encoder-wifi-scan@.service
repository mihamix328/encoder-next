[Unit]
Description=One bounded encoder Wi-Fi scan request
After=netplan-wpa-wlan0.service

[Service]
Type=exec
User=root
Group=encoder
ExecStart=/opt/encoder/bin/encoder-wifi-scan-helper
StandardInput=socket
StandardOutput=null
StandardError=journal
RuntimeDirectory=encoder-network
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
RuntimeMaxSec=25
TimeoutStopSec=2
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/encoder-network
RestrictAddressFamilies=AF_UNIX
MemoryMax=32M
TasksMax=8
