# Experimental Linux template; validate on the target before enabling.
[Unit]
Description=Read cached Wi-Fi results for encoder
After=netplan-wpa-wlan0.service

[Service]
Type=oneshot
User=root
Group=encoder
ExecStart=/opt/encoder/bin/encoder-wifi-collector
RuntimeDirectory=encoder-network
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0027
TimeoutStartSec=10
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/encoder-network
RestrictAddressFamilies=AF_UNIX
